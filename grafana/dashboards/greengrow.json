    {
      "id": 12,
      "type": "table",
      "title": "Command log with safety decisions (newest first)",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "greengrow-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT id, sim_ts, source, device, action, params::text AS params, status, reasons::text AS reasons FROM greenhouse_command ORDER BY id DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "accepted": {
                        "color": "green",
                        "text": "accepted"
                      },
                      "rejected": {
                        "color": "red",
                        "text": "rejected"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Daily light integral (mol/m²/day): acceptable band 12-20",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "greengrow-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('day', sim_ts) AS time, round((sum(light/54.0*1800)/1e6)::numeric,1) AS \"daily light\", 12 AS \"acceptable low\", 20 AS \"acceptable high\" FROM greenhouse_reading WHERE $__timeFilter(sim_ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "showPoints": "always",
            "pointSize": 6
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "acceptable.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "daily light"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Day and night temperature, per day (the day/night difference)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "greengrow-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('day', sim_ts) AS time, round(avg(temperature) FILTER (WHERE extract(hour from sim_ts) BETWEEN 13 AND 18)::numeric,1) AS \"afternoon mean\", round(min(temperature) FILTER (WHERE extract(hour from sim_ts) >= 22 OR extract(hour from sim_ts) < 6)::numeric,1) AS \"night low\" FROM greenhouse_reading WHERE $__timeFilter(sim_ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "showPoints": "always",
            "pointSize": 6
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "afternoon mean"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "night low"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "description": "The time axis is SIMULATED time (UTC) from the cached Cranfield weather period, not wall-clock time. The lines fill in from the left as the simulation advances. Use the weather scenario that matches WEATHER_SCENARIO."
}
