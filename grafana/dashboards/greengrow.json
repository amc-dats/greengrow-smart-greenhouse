    {
      "id": 5,
      "type": "timeseries",
      "title": "Medium moisture (%) with the watering thresholds of the season",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "greengrow-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sim_ts AS time, soil_moisture AS \"medium moisture\", CASE WHEN extract(month from sim_ts) IN (12,1,2) THEN 15 ELSE 30 END AS \"water below\", CASE WHEN extract(month from sim_ts) IN (12,1,2) THEN 40 ELSE 60 END AS \"target\" FROM greenhouse_reading WHERE $__timeFilter(sim_ts) ORDER BY sim_ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Temperature: greenhouse vs outside (the safety minimum follows the season)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "greengrow-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT r.sim_ts AS time, r.temperature AS \"greenhouse\", w.temperature AS \"outside\", CASE WHEN extract(month from r.sim_ts) IN (12,1,2) THEN 10 ELSE 15 END AS \"safety minimum\", 28 AS \"vent opens above 28\" FROM greenhouse_reading r LEFT JOIN greenhouse_weathersample w ON w.sample_id = r.sample_id WHERE $__timeFilter(r.sim_ts) ORDER BY r.sim_ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": [
