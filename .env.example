# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- secrets (use long random strings) ---
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
MQTT_EDGE_PASSWORD=
MQTT_ACTUATORS_PASSWORD=
MQTT_BACKEND_PASSWORD=
API_KEY=            # header X-API-Key for write endpoints (commands, approvals)
SIM_TOKEN=          # header X-Sim-Token used by the edge node to read the generator

# --- Claude (assist). Leave blank to run the assist component in mock mode. ---
ANTHROPIC_API_KEY=
ASSIST_MODEL=claude-sonnet-5-5
ASSIST_MODE=auto    # auto | claude | mock

# --- simulation ---
SAMPLE_INTERVAL_MIN=30   # simulated minutes between samples (design value)
SIM_SPEED=1              # 1 = real time (one sample per 30 min). 180 = demo (one sample per 10 s)
WEATHER_SCENARIO=winter  # winter = coldest fortnight of 2025/26 at Cranfield; summer = June 2026 (cached real weather)
SIM_START=               # leave empty to start at the first hour of the weather data
AUTO_CONTROL=1           # 1 = rules-based automatic control on every reading
